<?xml version="1.0" ?>
<sdf version="1.10">
    <world name="delivery_world">

        <physics name="1ms" type="ignored">  <!--default from gazebo sim docs-->
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>  <!--default from gazebo sim docs-->
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>  <!--default from gazebo sim docs-->

        <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system" />
        <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system"><render_engine>ogre2</render_engine></plugin>

        <light type="directional" name="sun">  <!--default from gazebo sim docs-->
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">  <!--default from gazebo sim docs-->
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                        <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                    <surface>
                        <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
                    </surface>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                        <normal>0 0 1</normal>
                        <size>1000 1000</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <model name="cubes_environment">
            <static>true</static>
            <link name="link">
                <collision name="collision_sofa">
                    <pose>78.39 68.56 19.41 0 0 0.4</pose>
                    <geometry><box><size>40 100 40</size></box></geometry>
                </collision>
                <collision name="collision_straight_tabouret">
                    <pose>0 -42.5 11 0 0 0</pose>
                    <geometry><box><size>25 25 40</size></box></geometry>
                </collision>
                <collision name="collision_twist_tabouret">
                    <pose>-87 78.44 11 0 0 0.56</pose>
                    <geometry><box><size>25 25 40</size></box></geometry>
                </collision>
                <collision name="collision_stillage">
                    <pose>-104.22 -104.78 15.5 0 0 0</pose>
                    <geometry><box><size>25 25 40</size></box></geometry>
                </collision>
                <collision name="collision_closet">
                    <pose>-104.22 0 15.5 0 0 0</pose>
                    <geometry><box><size>25 64 40</size></box></geometry>
                </collision>
                <collision name="collision_tabouret_wall">
                    <pose>0 120.72 15.5 0 0 0</pose>
                    <geometry><box><size>260 12 40</size></box></geometry>
                </collision>
                <collision name="collision_closet_wall">
                    <pose>-120.72 0 15.5 0 0 0</pose>
                    <geometry><box><size>12 260 40</size></box></geometry>
                </collision>
                <collision name="collision_sofa_wall">
                    <pose>120.72 0 15.5 0 0 0</pose>
                    <geometry><box><size>12 260 40</size></box></geometry>
                </collision>
                <collision name="collision_stillage_wall">
                    <pose>0 -120.72 15.5 0 0 0</pose>
                    <geometry><box><size>260 12 40</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><mesh><uri>file:///home/danil/Documents/ROSWorkspaces/RosMiniProject/src/making_delivery/models/furniture.obj</uri></mesh></geometry>
                    <material>
                        <diffuse>1 1 1 1</diffuse>
                        <pbr><metal>
                            <albedo_map>resources://T_Furniture_BC_4K.png</albedo_map>
                            <roughness>1</roughness>
                            <metalness>0</metalness>
                        </metal></pbr>
                    </material>
                </visual>
            </link>
        </model>

        <gui fullscreen="0">  <!--default from gazebo sim docs-->
            <plugin filename="MinimalScene" name="3D View">
              <gz-gui>
                <title>3D View</title>
                <property type="bool" key="showTitleBar">false</property>
                <property type="string" key="state">docked</property>
              </gz-gui>

              <engine>ogre2</engine>
              <scene>scene</scene>
              <ambient_light>0.4 0.4 0.4</ambient_light>
              <background_color>0.8 0.8 0.8</background_color>
              <camera_pose>50 50 50 0 0.5 3.95</camera_pose>  <!--camera forward axis is x, rotation in radians-->
              <camera_clip>
                <near>0.25</near>
                <far>25000</far>
              </camera_clip>
            </plugin>
            <plugin filename="GzSceneManager" name="Scene Manager">
              <gz-gui>
                <property key="resizable" type="bool">false</property>
                <property key="width" type="double">5</property>
                <property key="height" type="double">5</property>
                <property key="state" type="string">floating</property>
                <property key="showTitleBar" type="bool">false</property>
              </gz-gui>
            </plugin>
            <plugin filename="VisualizeLidar" name="Visualize Lidar" />
        </gui>

    </world>
</sdf>